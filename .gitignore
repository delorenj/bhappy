**/.claude/settings.local.json
~/DevCloud/.gitignore_global
node_modules
*.mp4
*.mp3
*.zip
*.aab
.lastagent

# project assets shipped with the app
!public/intro.mp4

# hyperframes render outputs (regenerable from intro/index.html)
hyperframes/intro/renders/

# build & local state
dist/
.wrangler/
.logs/
.mise/
.tmp/

# stitch generated assets (design source files committed; generated PNG/HTML are local)
.stitch/designs/*.png

# Secrets — .env is materialized from .env.op by `op inject` on mise enter,
# staged through a mktemp file and moved into place only on success.
# NEVER commit it. .env.op holds only 1Password references or safe literals and IS committed.
.env
.env.*
!.env.op

# Canonical agent config lives in .agents; generated skill projections stay local.
/.agents/skills
